name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱠᱚᱢ ᱠᱷᱚᱱ ᱠᱚᱢ ᱠᱷᱟᱢᱵᱟ ᱚᱥᱟᱨ</value></prop><prop oor:name="TooltipLabel" oor:type="xs:string"><value xml:lang="sat-Olck">ᱠᱚᱢ ᱠᱷᱚᱱ ᱠᱚᱢ ᱠᱷᱟᱢᱵᱟ ᱚᱥᱟᱨ: ᱡᱤᱱᱤᱥ ᱯᱷᱤᱴ ᱞᱟᱹᱜᱤᱫ ᱵᱟᱪᱷᱟᱣ ᱠᱷᱟᱢᱵᱟ ᱨᱮᱭᱟᱜ ᱚᱥᱟᱨ ᱵᱮᱵᱷᱟᱨ ᱢᱮ</value></prop></node><node oor:name=".uno:DistributeColumns"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">~ᱠᱷᱟᱢᱵᱟ ᱥᱚᱢᱟᱱ ᱦᱟᱴᱤᱱᱜ ᱢᱮ</value></prop></node><node oor:name=".uno:IncrementIndentValue"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱤᱱᱰᱮᱱᱴ ᱵᱷᱮᱞᱭᱩ ᱵᱟᱲᱛᱤᱭ ᱢᱮ</value></prop></node><node oor:name=".uno:SetMinimalRowHeight"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱠᱚᱢ ᱠᱷᱚᱱ ᱠᱚᱢ ᱛᱷᱟᱨ ᱩᱥᱩᱞ</value></prop><prop oor:name="TooltipLabel" oor:type="xs:string"><value xml:lang="sat-Olck">ᱠᱚᱢ ᱠᱷᱚᱱ ᱠᱚᱢ ᱛᱷᱟᱨ ᱩᱥᱩᱞ: ᱡᱤᱱᱤᱥ ᱯᱷᱤᱴ ᱞᱟᱹᱜᱤᱫ ᱵᱟᱪᱷᱟᱣ ᱛᱷᱟᱨ ᱨᱮᱭᱟᱜ ᱩᱥᱩᱞ ᱵᱮᱵᱷᱟᱨ ᱢᱮ</value></prop></node><node oor:name=".uno:DistributeRows"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱛᱷᱟᱨ ᱠᱚ ᱥᱚᱢᱟᱱ ᱜᱮ ᱦᱟᱴᱤᱱᱜ ᱢᱮ</value></prop></node><node oor:name=".uno:WrapContour"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱠᱚᱱᱴᱩᱨ ᱵᱮᱫᱷᱟᱣ ᱢᱮ</value></prop><prop oor:name="ContextLabel" oor:type="xs:string"><value xml:lang="sat-Olck">~ᱠᱚᱱᱴᱳᱨ</value></prop></node><node oor:name=".uno:DecrementIndentValue"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱰᱤᱠᱨᱮᱢᱮᱱᱴ ᱤᱱᱰᱮᱱᱴ ᱵᱷᱮᱞᱭᱩ</value></prop></node><node oor:name=".uno:MergeTable"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱴᱮᱵᱩᱞ ᱢᱤᱨᱡᱽ ᱢᱮ</value></prop></node><node oor:name=".uno:GoToPrevPara"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱞᱟᱦᱟ ᱨᱮᱱᱟᱜ ᱯᱮᱨᱟᱜᱽᱨᱟᱯᱷ ᱨᱮ</value></prop></node><node oor:name=".uno:RowSplit"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱥᱟᱦᱴᱟ ᱠᱚ ᱯᱟᱨᱚᱢ ᱛᱮ ᱛᱷᱟᱨ</value></prop></node><node oor:name=".uno:SelectText"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱯᱟᱨᱟᱜᱽᱨᱟᱯᱷ ᱵᱟᱪᱷᱟᱣ ᱢᱮ</value></prop></node><node oor:name=".uno:SelectionCycle"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱥᱟᱭᱠᱮᱞ ᱵᱟᱪᱷᱟᱣ ᱢᱮ</value></prop></node><node oor:name=".uno:GoToNextPara"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱫᱚᱥᱟᱨ ᱯᱟᱨᱟᱜᱽᱨᱟᱯᱷ ᱛᱮ</value></prop></node><node oor:name=".uno:GotoNextPlacemarker"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱫᱚᱥᱟᱨ ᱯᱞᱮᱥᱦᱳᱞᱰᱟᱨ ᱴᱷᱮᱱ</value></prop></node><node oor:name=".uno:GotoPrevPlacemarker"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱞᱟᱦᱟ ᱨᱮᱱᱟᱜ ᱯᱞᱮᱥᱦᱳᱞᱰᱟᱨ ᱴᱷᱮᱱ</value></prop></node><node oor:name=".uno:TableModeFix"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱴᱮᱵᱩᱞ: ᱴᱷᱟᱹᱣᱠᱟᱹ</value></prop></node><node oor:name=".uno:JumpToStartOfDoc"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱥᱚᱡᱷᱮ ᱰᱚᱠᱭᱩᱢᱮᱱᱴ ᱮᱦᱚᱵᱚᱜ ᱞᱟᱹᱜᱤᱫ</value></prop></node><node oor:name=".uno:TableModeFixProp"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱴᱮᱵᱩᱞ: ᱴᱷᱟᱹᱣᱠᱟᱹ, ᱥᱚᱢᱟᱱᱛᱮᱫ</value></prop></node><node oor:name=".uno:JumpToEndOfDoc"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱥᱚᱡᱷᱮ ᱰᱚᱠᱭᱩᱢᱮᱱᱴ ᱢᱩᱪᱟᱹᱫ ᱨᱮ</value></prop></node><node oor:name=".uno:TableModeVariable"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱴᱮᱵᱩᱞ: ᱣᱮᱨᱭᱟᱵᱚᱞ</value></prop></node><node oor:name=".uno:TextWrap"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱚᱞ ᱵᱮᱫᱷᱟᱣ...</value></prop><prop oor:name="ContextLabel" oor:type="xs:string"><value xml:lang="sat-Olck">ᱥᱟᱥᱟᱯᱲᱟᱣ...</value></prop></node><node oor:name=".uno:GotoNextIndexMark"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱫᱚᱥᱟᱨ ᱤᱱᱰᱮᱠᱥ ᱮᱱᱴᱨᱤ ᱨᱮ ᱥᱮᱱᱚᱜ ᱢᱮ</value></prop></node><node oor:name=".uno:GotoPrevIndexMark"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱞᱟᱦᱟ ᱨᱮᱱᱟᱜ ᱤᱱᱰᱮᱠᱥ ᱮᱱᱴᱨᱤ ᱨᱮ ᱥᱮᱱᱚᱜ ᱢᱮ</value></prop></n