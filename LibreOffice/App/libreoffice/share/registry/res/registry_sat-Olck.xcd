prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱯᱚᱱᱚᱛ ᱨᱟᱡ ᱾ᱯᱚᱱᱚᱛ ᱟᱨ ᱵᱟᱝ ᱨᱟᱡ᱾</value></prop></node><node oor:name="countryorregion"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱫᱤᱥᱚᱢᱟᱨ ᱵᱟᱝ ᱡᱟᱭᱜᱟ ᱾ᱫᱤᱥᱚᱢ ᱟᱨ ᱵᱟᱝ ᱡᱟᱭᱜᱟ᱾</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱫᱤᱥᱚ़ᱢ ᱡᱟᱭᱜᱟ ᱾ᱫᱤᱥᱚᱢ ᱟᱨ  ᱡᱟᱭᱜᱟ  ᱾</value></prop></node><node oor:name="phonenumber"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱥᱟᱸᱜᱤᱧ ᱜᱟᱞ ᱞᱮᱠᱷᱟ ᱾ᱥᱟᱸᱜᱤᱧ ᱜᱟᱞ ᱞᱮᱠᱷᱟ᱾</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱥᱟᱸᱜᱤᱧ ᱜᱟᱞ ᱞᱮᱠᱷᱟ ᱾ᱥᱟᱸᱜᱤᱧ ᱜᱟᱞ ᱞᱮᱠᱷᱟ ᱾</value></prop></node><node oor:name="faxnumber"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱯᱷᱮᱠᱥ ᱮᱞ</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱯᱷᱮᱠᱥ ᱞᱮᱠᱷᱟ᱾ᱯᱷᱮᱠᱥ ᱞᱮᱠᱷᱟ ᱾</value></prop></node><node oor:name="mobilenumber"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱢᱚᱵᱟᱤᱞ ᱞᱮᱠᱷᱟ ᱾ᱢᱚᱵᱟᱤᱞ ᱞᱮᱠᱷᱟ᱾</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱢᱚᱵᱟᱭᱤᱞ ᱮᱞ</value></prop></node><node oor:name="birthdate"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱡᱟᱱᱟᱢ ᱢᱟᱹᱦᱤᱫ᱾ᱡᱟᱱᱟᱢ ᱢᱟᱹᱦᱤᱫ᱾</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱡᱟᱱᱟᱢ ᱢᱟᱹᱦᱤᱫ᱾ᱡᱟᱱᱟᱢ ᱢᱟᱹᱦᱤᱫ᱾</value></prop></node><node oor:name="datehired"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱢᱟᱹᱦᱤᱫ  ᱵᱷᱟᱲᱟ᱾ᱢᱟᱹᱦᱤᱫ  ᱵᱷᱟᱲᱟ᱾</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱢᱟᱹᱦᱤᱫ  ᱵᱷᱟᱲᱟ᱾ᱢᱟᱹᱦᱤᱫ  ᱵᱷᱟᱲᱟ᱾</value></prop></node><node oor:name="departmentID"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱰᱤᱯᱟᱨᱴᱢᱮᱱᱴ ᱟᱭᱤ ᱰᱤ</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱢᱟᱦᱟᱞ ID᱾</value></prop></node><node oor:name="salary"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱯᱟᱣᱱᱟ ᱾</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱯᱟᱣᱱᱟ ᱾</value></prop></node><node oor:name="billingrate"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱵᱤᱞ ᱫᱚᱨᱵᱤᱞ ᱫᱚᱨ</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱵᱤᱞ ᱫᱚᱨᱵᱤᱞ ᱫᱚᱨ</value></prop><