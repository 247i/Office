ᱣᱤᱫᱷᱟᱹᱱ</value></prop></node><node oor:name="paymentmethod"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱫᱚᱨᱢᱟ ᱣᱤᱫᱷᱟᱹᱱ᱾ᱫᱚᱨᱢᱟ ᱣᱤᱫᱷᱟᱱ ᱾</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱫᱚᱨᱢᱟ ᱣᱤᱫᱷᱟᱹᱱ᱾ᱫᱚᱨᱢᱟ  ᱣᱤᱫᱷᱟᱱ᱾</value></prop></node><node oor:name="checknumber"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱪᱮᱠ ᱞᱮᱠᱷᱟᱪᱮᱠ ᱞᱮᱠᱷᱟ</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱪᱮᱠ ᱞᱮᱠᱷᱟ (~n)ᱪᱮᱠ ᱞᱮᱠᱷᱟ</value></prop></node><node oor:name="creditcardtype"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱠᱨᱮᱰᱤᱴ ᱠᱟᱨᱰ ᱞᱮᱠᱟᱱᱠᱨᱮᱰᱤᱴ ᱠᱟᱨᱰ ᱞᱮᱠᱟᱱ</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱠᱨᱮᱰᱤᱴ ᱠᱟᱨᱰ ᱞᱮᱠᱟᱱᱠᱨᱮᱰᱤᱴ ᱠᱟᱨᱰ ᱞᱮᱠᱟᱱ</value></prop></node><node oor:name="creditcardnumber"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱠᱨᱮᱰᱤᱴ ᱠᱟᱨᱰ ᱞᱮᱠᱷᱟᱜᱨᱮᱰᱤᱴ ᱠᱟᱨᱰ ᱞᱮᱠᱷᱟ</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱥᱤ ᱠᱟᱨᱰ ᱞᱮᱠᱷᱟᱥᱤ ᱠᱟᱨᱰ ᱞᱮᱠᱷᱟ</value></prop></node><node oor:name="cardholder"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱠᱟᱨᱰ ᱧᱟᱹᱢᱤᱡ ᱾ᱠᱟᱨᱰ ᱧᱟᱹᱢᱤᱡ᱾</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱠᱟᱨᱰ ᱧᱟᱹᱢᱤᱡ ᱾ᱠᱟᱨᱰ ᱧᱟᱹᱢᱤᱡ᱾</value></prop></node><node oor:name="creditcardExpdate"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱠᱨᱮᱰᱤᱴ ᱠᱟᱨᱰ ᱳᱠᱛᱚ ᱯᱟᱨᱚᱢ ᱢᱟᱹᱦᱤᱫᱠᱨᱮᱰᱤᱴ ᱠᱟᱨᱰ ᱳᱠᱛᱚ ᱯᱟᱨᱚᱢ ᱢᱟᱹᱦᱤᱫ</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱥᱤ᱾ᱥᱤ᱾ ᱳᱠᱛᱚᱯᱟᱨᱚᱢ ᱢᱟᱹᱦᱤᱫᱥᱤ᱾ᱥᱤ᱾ ᱳᱠᱛᱚᱯᱟᱨᱚᱢ ᱢᱟᱹᱦᱤᱫ</value></prop></node><node oor:name="creditcardauthorizationnumber"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱠᱨᱮᱰᱤᱴ ᱠᱟᱨᱰ ᱟᱞᱟᱭ ᱞᱮᱠᱷᱟ (~t)ᱠᱨᱮᱰᱤᱴ ᱠᱟᱨᱰ ᱟᱞᱟᱭ ᱞᱮᱠᱷᱟ</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱥᱤ᱾ᱥᱤ ᱟᱞᱟᱭ ᱞᱮᱠᱷᱟ</value></prop></node><node oor:name="paymentterms"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱠᱩᱲᱟᱭ ᱫᱚᱵᱠᱚ ᱾ᱫᱚᱨᱢᱟ ᱫᱚᱵ᱾</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱠᱩᱲᱟᱭ ᱫᱚᱵ᱾ᱫᱚᱨᱢᱟ ᱫᱚᱵ ᱾</value></prop></node><node oor:name="paymentmethodID"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱫᱚᱨᱢᱟ ᱣᱤᱫᱷᱟᱹᱱ I