 ᱢᱮ</value></prop></node><node oor:name=".uno:AcceptTrackedChange"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱦᱟᱛᱟᱣ</value></prop><prop oor:name="TooltipLabel" oor:type="xs:string"><value xml:lang="sat-Olck">Accept Track Change</value></prop><prop oor:name="PopupLabel" oor:type="xs:string"><value xml:lang="sat-Olck">ᱵᱚᱫᱚᱞ ᱟᱝᱜᱚᱪ ᱢᱮ</value></prop></node><node oor:name=".uno:AcceptTrackedChangeToNext"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱟᱝᱜᱚᱪ ᱢᱮ ᱟᱨ ᱛᱟᱭᱚᱢ ᱥᱮᱫ ᱥᱮᱱᱚᱜ ᱢᱮ</value></prop><prop oor:name="TooltipLabel" oor:type="xs:string"><value xml:lang="sat-Olck">Accept Track Change and select the next one</value></prop></node><node oor:name=".uno:AcceptAllTrackedChanges"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱥᱟᱱᱟᱢ ᱠᱚ ᱟᱝᱜᱚᱪ ᱠᱚᱢ</value></prop><prop oor:name="TooltipLabel" oor:type="xs:string"><value xml:lang="sat-Olck">ᱥᱟᱱᱟᱢ ᱴᱨᱮᱠ ᱠᱟᱱ ᱵᱚᱫᱚᱞ ᱠᱚ ᱟᱝᱜᱚᱪ ᱢᱮ</value></prop><prop oor:name="PopupLabel" oor:type="xs:string"><value xml:lang="sat-Olck">ᱥᱟᱱᱟᱢ ᱵᱚᱫᱚᱞ ᱠᱚ ᱟᱝᱜᱚᱪ ᱢᱮ</value></prop></node><node oor:name=".uno:ReinstateTrackedChange"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱵᱟᱝ ᱦᱩᱭᱩᱜ ᱢᱮᱱᱠᱷᱟᱱ ᱴᱨᱮᱠ</value></prop><prop oor:name="TooltipLabel" oor:type="xs:string"><value xml:lang="sat-Olck">ᱴᱨᱮᱠ ᱠᱟᱱ ᱵᱚᱫᱚᱞ ᱵᱟᱝ ᱦᱩᱭᱩᱜ ᱛᱟᱢᱟ ᱢᱮᱱᱠᱷᱟᱱ ᱫᱚᱦᱚ ᱠᱟᱜ ᱢᱮ</value></prop></node><node oor:name=".uno:NextTrackedChange"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱯᱚᱨᱮ</value></prop><prop oor:name="TooltipLabel" oor:type="xs:string"><value xml:lang="sat-Olck">Next Track Change</value></prop></node><node oor:name=".uno:PreviousTrackedChange"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱞᱟᱦᱟ</value></prop><prop oor:name="TooltipLabel" oor:type="xs:string"><value xml:lang="sat-Olck">Previous Track Change</value></prop></node><node oor:name=".uno:UpdateAllLinks"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">~ᱞᱤᱝᱠ</value></prop><prop oor:name="PopupLabel" oor:type="xs:string"><value xml:lang="sat-Olck">ᱟᱯᱰᱮᱴ ᱢᱮ ~ᱞᱤᱝᱠ</value></prop></node><node oor:name=".uno:TrackChanges"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">~ᱨᱮᱠᱚᱨᱰ</value></prop><prop oor:name="TooltipLabel" oor:type="xs:string"><value xml:lang="sat-Olck">Record Track Changes</value></prop></node><node oor:name=".uno:TrackChangesBar"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">Track Changes Functions</value></prop><prop oor:name="TooltipLabel" oor:type="xs:string"><value xml:lang="sat-Olck">Show Track Changes Functions</value></prop></node><node oor:name=".uno:ShowTrackedChanges"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">Show Track Changes</value></prop><prop oor:name="ContextLabel" oor:type="xs:string"><value xml:lang="sat-Olck">ᱩᱫᱩᱜ</value></prop><prop oor:name="TooltipLabel" oor:type="xs:string"><value xml:lang="sat-Olck">Show track changes</value></prop></node><node oor:name=".uno:ViewTrackChanges"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱴᱨᱮᱠ ᱠᱟᱱ ᱩᱫᱩᱜ ᱢᱮ ~ ᱵᱚᱫᱚᱞ ᱠᱚ</value></prop></node><node oor:name=".uno:ShowInlineTooltips"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱴᱩᱞᱴᱤᱯᱥ</value></prop><prop oor:name="TooltipLabel" oor:type="xs:string"><value xml:lang="sat-Olck">ᱴᱩᱞᱴᱤᱯᱥ ᱨᱮ ᱵᱚᱫᱚᱞ ᱚᱱᱚᱞᱤᱭᱟᱹ ᱩᱫᱩᱜ ᱢᱮ</value></prop></node><node oor:name=".uno:UseHeaderFooterMenu"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱦᱮᱰᱟᱨ/ᱯᱷᱩᱴᱟᱨ ᱢᱮᱱᱩ ᱵᱮᱵᱷᱟᱨ ᱢᱮ</value></prop><prop oor:name="TooltipLabel" oor:type="xs:string"><value xml:lang="sat-Olck">ᱯᱷᱞᱟᱭ ᱨᱮ ᱦᱮᱰᱟᱨ/ᱯᱷᱩᱴᱟᱨ ᱵᱮᱱᱟᱣ ᱞᱟᱹᱜᱤᱫ ᱮᱰᱵᱷᱟᱱᱥ ᱯᱚᱯᱟᱯ ᱢᱮᱱᱩ ᱵᱮᱵᱷᱟᱨ ᱢᱮ</value></prop></node><node oor:name=".uno:ShowOutlineContentVisibilityButton"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱟᱩᱴᱞᱟᱭᱤᱱ-ᱯᱷᱚᱞᱰᱤᱝ ᱵᱩᱛᱟᱢ ᱩᱫᱩᱜ ᱢᱮ</value></prop><prop oor:name="TooltipLabel" oor:type="xs:string"><value xml:lang="sat-Olck">ᱵᱟᱦᱨᱮ ᱞᱟᱹᱴᱩᱢ ᱨᱮ ᱜᱚᱲᱚ ᱞᱟᱹᱜᱤᱫ ᱵᱚᱦᱚᱜ ᱟᱨ ᱥᱟᱵᱽᱦᱮᱰᱤᱝ ᱛᱟᱭᱚᱢ ᱨᱮ ᱢᱤᱫ ᱵᱩᱛᱟᱢ ᱩᱫᱩᱜ ᱢᱮ᱾ ᱵᱩᱛᱟᱢ ᱵᱮᱜᱚᱨ ᱦᱚᱸ, ᱟᱢ ᱱᱮᱵᱷᱤᱜᱮᱴᱚᱨ ᱥᱟᱶ ᱟᱩᱴᱞᱟᱭᱤᱱ ᱯᱷᱚᱞᱰᱤᱝ ᱫᱟᱲᱮᱭᱟᱜᱼᱟᱢ᱾</value></prop></node><node oor:name=".uno:OutlineLevelsShown"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱟᱩᱴᱞᱟᱭᱤᱱ ᱞᱮᱵᱮᱞ ᱩᱫᱩᱜ ᱢᱮ...</value></prop></node><node oor:name=".uno:HighlightCharDF"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱥᱯᱚᱴᱞᱟᱭᱤᱴ ᱪᱟᱹᱨᱤᱛ ᱥᱚᱡᱷᱮ ᱯᱷᱚᱨᱢᱟᱴᱤᱝ</value></prop><prop oor:name="ContextLabel" oor:type="xs:string"><value xml:lang="sat-Olck">ᱪᱤᱠᱤ ᱥᱚᱡᱷᱮ ᱯᱷᱚᱨᱢᱟᱴᱤᱝ</value></prop></node><node oor:name=".uno:SpotlightParaStyles"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱥᱯᱚᱴᱞᱟᱭᱤᱴ ᱯᱮᱨᱟᱜᱽᱨᱟᱯᱷ ᱥᱴᱟᱭᱤᱞ</value></prop><prop oor:name="ContextLabel" oor:type="xs:string"><value xml:lang="sat-Olck">ᱯᱮᱨᱟᱜᱽᱨᱟᱯᱷ ᱥᱴᱟᱭᱤᱞ</value></prop></node><node oor:name=".uno:SpotlightCharStyles"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱥᱯᱚᱴᱞᱟᱭᱤᱴ ᱪᱟᱹᱨᱤᱛ ᱥᱴᱟᱭᱤᱞ</value></prop><prop oor:name="ContextLabel" oor:type="xs:string"><value xml:lang="sat-Olck">ᱪᱟᱹᱨᱤᱛ ᱥᱴᱟᱭᱤᱞ</value></prop></node><node oor:name=".uno:ShowChangesInMargin"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱢᱟᱨᱡᱤᱱ ᱨᱮ ᱴᱨᱮᱠ ᱠᱟᱱ ᱰᱤᱞᱤᱥᱚᱱ ᱩᱫᱩᱜ ᱢᱮ</value></prop><prop oor:name="TooltipLabel" oor:type="xs:string"><value xml:lang="sat-Olck">ᱢᱟᱨᱡᱤᱱ ᱨᱮ ᱴᱨᱮᱠ ᱠᱟᱱ ᱰᱤᱞᱤᱥᱚᱱ ᱩᱫᱩᱜ ᱢᱮ</value></prop></node><node oor:name=".uno:GotoPage"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱥᱟᱦᱴᱟ ᱨᱮ ᱥᱮᱱᱚᱜ ᱢᱮ...</value></prop></node><node oor:name=".uno:CommentChangeTracking"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">~ᱴᱤᱯᱚᱬᱤ...</value></prop><prop oor:name="TooltipLabel" oor:type="xs:string"><value xml:lang="sat-Olck">Insert Track Change Comment</value></prop></node><node oor:name=".uno:UpdateAll"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">~ᱡᱚᱛᱚ ᱟᱯᱰᱮᱴ ᱢᱮ</value></prop></node><node oor:name="