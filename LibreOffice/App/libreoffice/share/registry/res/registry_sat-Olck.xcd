oor:name="ShortName"><value xml:lang="sat-Olck">ᱛᱮᱭᱟᱨ ᱨᱮᱭᱟᱜ ᱳᱠᱛᱚᱛᱮᱭᱟᱨ ᱨᱮᱭᱟᱜ ᱳᱠᱛᱚ</value></prop></node><node oor:name="caloriesperserving"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱠᱟᱹᱢᱤ ᱯᱤᱪᱷᱤ ᱠᱮᱞᱚᱨᱤᱠᱟᱹᱢᱤ ᱯᱤᱪᱷᱤ ᱠᱮᱞᱚᱨᱤ</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱠᱟᱹᱢᱤ ᱯᱤᱪᱷᱤ ᱠᱮᱞᱚᱨᱤᱠᱟᱹᱢᱤ ᱯᱤᱪᱷᱤ ᱠᱮᱞᱚᱨᱤ</value></prop></node><node oor:name="nutritionalinformation"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱡᱚᱢ ᱧᱩᱸ ᱵᱟᱵᱚᱛ ᱞᱟᱹᱭ ᱥᱚᱫᱚᱨᱡᱚᱢ ᱧᱩᱸ ᱵᱟᱵᱚᱛ ᱞᱟᱹᱭ ᱥᱚᱫᱚᱨ</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱡᱚᱢ ᱧᱩᱸ ᱵᱟᱵᱚᱛ ᱞᱟᱹᱭ ᱥᱚᱫᱚᱨ (~b)ᱡᱚᱢ ᱧᱩᱸ ᱵᱟᱵᱚᱛ ᱞᱟᱹᱭ ᱥᱚᱫᱚᱨ</value></prop></node><node oor:name="ingredients"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱳᱸᱥᱚ ᱠᱚᱳᱸᱥᱚ ᱠᱚ</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱳᱸᱥᱚ ᱠᱚᱳᱸᱥᱚ ᱠᱚ</value></prop></node><node oor:name="instructions"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱩᱱᱩᱫᱩᱜ ᱠᱚ</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱩᱱᱩᱫᱩᱜ</value></prop></node><node oor:name="utensils"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱛᱷᱟᱹᱨᱤ ᱵᱟᱹᱴᱤ ᱥᱟᱯᱟᱯ ᱠᱚ᱾ (~e)ᱛᱷᱟᱹᱨᱤ ᱵᱟᱹᱴᱤ ᱥᱟᱯᱟᱯ ᱠᱚ᱾</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱛᱷᱟᱹᱨᱤ ᱵᱟᱹᱴᱤ ᱥᱟᱯᱟᱯ ᱠᱚ᱾ (~e)ᱛᱷᱟᱹᱨᱤ ᱵᱟᱹᱴᱤ ᱥᱟᱯᱟᱯ ᱠᱚ᱾</value></prop></node><node oor:name="notes"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱱᱚᱴᱥ</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱱᱚᱴᱥ</value></prop></node></node></node><node oor:name="plants"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱫᱟᱨᱮ ᱠᱚᱫᱟᱨᱮ ᱠᱚ</value></prop><node oor:name="Fields"><node oor:name="plantID"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱫᱟᱨᱮ ᱠᱚ ID᱾ᱫᱟᱨᱮ ID᱾</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱫᱟᱨᱮ ᱠᱚ ID᱾ᱫᱟᱨᱮ ID᱾</value></prop></node><node oor:name="commonname"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱥᱚᱢᱟᱱ ᱧᱩᱛᱩᱢ ᱾</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱥᱚᱢᱟᱱ ᱧᱩᱛᱩᱢ ᱾</value></prop></node><node oor:name=