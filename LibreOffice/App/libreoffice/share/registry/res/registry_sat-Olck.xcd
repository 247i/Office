ries"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱥᱮᱠᱥᱚᱱ ᱥᱤᱢᱟᱹ (ᱵᱟᱝ ᱵᱩᱡᱷᱟᱹᱣ ᱟᱠᱟᱱ)</value></prop></node><node oor:name=".uno:ThesaurusDialog"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">~ᱛᱷᱤᱥᱚᱨᱟᱥ...</value></prop></node><node oor:name=".uno:BackColor"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱪᱟᱹᱨᱤᱛ ᱦᱟᱭᱞᱟᱭᱤᱴᱤᱝ ᱨᱚᱝ</value></prop><prop oor:name="TooltipLabel" oor:type="xs:string"><value xml:lang="sat-Olck">ᱪᱤᱠᱤ ᱦᱟᱭᱞᱟᱭᱤᱴᱤᱝ ᱨᱚᱝ (ᱵᱟᱝ ᱵᱮᱵᱷᱟᱨ ᱟᱠᱟᱱᱟ - ᱪᱟᱨᱵᱮᱠᱠᱚᱞᱚᱨ ᱵᱮᱵᱷᱟᱨ ᱢᱮ)</value></prop></node><node oor:name=".uno:Fields"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱠᱷᱮᱛ ᱠᱚ</value></prop></node><node oor:name=".uno:VRuler"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱣᱮᱨᱴᱤᱠᱟᱞ ᱨᱩᱞᱟᱨ</value></prop></node><node oor:name=".uno:Hyphenate"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱦᱟᱭᱯᱷᱮᱱᱮᱥᱚᱱ...</value></prop><prop oor:name="TooltipLabel" oor:type="xs:string"><value xml:lang="sat-Olck">ᱞᱮᱵᱽᱲᱮᱡ ᱦᱟᱭᱯᱷᱮᱱ ᱵᱚᱞᱚᱱ ᱢᱮ...</value></prop></node><node oor:name=".uno:NoBreak"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱡᱤᱨᱟᱹᱣ ᱵᱟᱹᱱᱩᱜᱼᱟ</value></prop></node><node oor:name=".uno:VScroll"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱣᱮᱨᱴᱤᱠᱟᱞ ᱥᱠᱨᱚᱞ ᱵᱟᱨ</value></prop></node><node oor:name=".uno:AddAllUnknownWords"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱵᱟᱝ ᱵᱟᱰᱟᱭ ᱟᱹᱲᱟᱹ ᱠᱚ ᱥᱮᱞᱮᱫ ᱢᱮ</value></prop></node><node oor:name=".uno:HScroll"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱜᱟᱱᱟᱴ ᱥᱠᱨᱚᱞ ᱵᱟᱨ</value></prop></node><node oor:name=".uno:ChapterNumberingDialog"><prop oor:name="Label" oor:type="xs:string"><value xml:lang="sat-Olck">ᱵᱚᱦᱚᱜ ~ ᱮᱞᱮᱞ...</value></prop><prop oor:name="TooltipLabel" oor:type="xs:string"><value xml:lang="sat-Olck">ᱦᱮᱰᱤᱝ ᱱᱟᱢᱵᱚᱨᱤᱝ ᱥᱮᱴ ᱢᱮ</value></prop></node><node oor:name=".uno:ControlCodes"><prop oor:name="Label"