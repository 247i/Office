ue></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱴᱷᱤᱠᱟᱹᱱᱟ ᱟᱭᱤ ᱰᱤ</value></prop></node><node oor:name="firstname"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱯᱩᱭᱞᱩ ᱧᱩᱛᱩᱢ</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱯᱩᱭᱞᱩ ᱧᱩᱛᱩᱢ</value></prop></node><node oor:name="lastname"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱢᱩᱪᱟᱹᱫ ᱧᱩᱛᱩᱢ</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱢᱩᱪᱟᱹᱫ ᱧᱩᱛᱩᱢ</value></prop></node><node oor:name="title"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱥᱟᱛᱷᱟᱢ</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱥᱟᱛᱷᱟᱢ</value></prop></node><node oor:name="address"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱴᱷᱤᱠᱟᱹᱱᱟ</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱴᱷᱤᱠᱟᱹᱱᱟ</value></prop></node><node oor:name="city"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱥᱮᱸᱲᱟ ᱥᱚᱦᱚᱨ᱾ᱥᱦᱨ</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱥᱮᱸᱲᱟ ᱥᱚᱦᱚᱨ᱾ᱥᱦᱨ</value></prop></node><node oor:name="postalcode"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱰᱟᱠ ᱪᱤᱱᱦᱟᱹ ᱞᱮᱠᱷᱟ᱾ᱰᱟᱠ ᱪᱤᱱᱦᱟᱹ ᱞᱮᱠᱷᱟ᱾</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱰᱟᱠ ᱪᱤᱱᱦᱟᱹ ᱞᱮᱠᱷᱟ᱾ᱰᱟᱠ ᱪᱤᱱᱦᱟᱹ ᱞᱮᱠᱷᱟ᱾</value></prop></node><node oor:name="stateorprovince"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱯᱚᱱᱚᱛ ᱟᱨ ᱵᱟᱝ ᱨᱟᱹᱡ ᱾ᱯᱚᱱᱚᱛ ᱟᱨ ᱵᱟᱝ ᱨᱟᱡ ᱾</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱯᱚᱱᱚᱛ ᱨᱟᱡ ᱾ᱯᱚᱱᱚᱛ ᱟᱨ ᱵᱟᱝ ᱨᱟᱡ᱾</value></prop></node><node oor:name="countryorregion"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱫᱤᱥᱚᱢᱟᱨ ᱵᱟᱝ ᱡᱟᱭᱜᱟ ᱾ᱫᱤᱥᱚᱢ ᱟᱨ ᱵᱟᱝ ᱡᱟᱭᱜᱟ᱾</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱫᱤᱥᱚ़ᱢ ᱡᱟᱭᱜᱟ ᱾ᱫᱤᱥᱚᱢ ᱟᱨ  ᱡᱟᱭᱜᱟ  ᱾</value></prop></node><node oor:name="phonenumber"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱥᱟᱸᱜᱤᱧ ᱜᱟᱞ ᱞᱮᱠᱷᱟ ᱾ᱥᱟᱸᱜᱤᱧ ᱜᱟᱞ ᱞᱮᱠᱷᱟ᱾</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱥᱟᱸᱜᱤᱧ ᱜᱟᱞ ᱞᱮᱠᱷᱟ ᱾ᱥᱟᱸᱜᱤᱧ ᱜᱟᱞ ᱞᱮᱠᱷᱟ ᱾</value></prop></node><node oor:name="faxnumber"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱯᱷᱮᱠᱥ ᱮᱞ</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱯᱷᱮᱠᱥ ᱞᱮᱠᱷᱟ᱾ᱯᱷᱮᱠᱥ ᱞᱮᱠᱷᱟ ᱾</value></prop></node><node oor:name="mobilenumber"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱢᱚᱵᱟᱤᱞ ᱞᱮᱠᱷᱟ ᱾ᱢᱚᱵᱟᱤᱞ ᱞᱮᱠᱷᱟ᱾</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱢᱚᱵᱟᱭᱤᱞ ᱮᱞ</value></prop></node><node oor:name="emailaddress"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱤᱢᱮᱞ ᱴᱷᱤᱠᱟᱹᱱᱟ</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱤᱢᱮᱞ  ᱴᱷᱤᱠᱟᱹᱱᱟ ᱾ᱤᱢᱮᱞ ᱴᱷᱤᱠᱟᱹᱱᱟ ᱾</value></prop></node><node oor:name="salutation"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱡᱚᱦᱟᱨ</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱡᱚᱦᱟᱨ</value></prop></node><node oor:name="birthdate"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱡᱟᱱᱟᱢ ᱢᱟᱹᱦᱤᱫ᱾ᱡᱟᱱᱟᱢ ᱢᱟᱹᱦᱤᱫ᱾</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱡᱟᱱᱟᱢ ᱢᱟᱹᱦᱤᱫ᱾ᱡᱟᱱᱟᱢ ᱢᱟᱹᱦᱤᱫ᱾</value></prop></node><node oor:name="sendcard"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱠᱟᱨᱰ ᱠᱩᱞ ᱾ᱠᱟᱨᱰ ᱠᱩᱞ᱾</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱠᱟᱨᱰ ᱠᱩᱞ ᱾ᱠᱟᱨᱰ ᱠᱩᱞ᱾</value></prop></node><node oor:name="maritalstatus"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱵᱟᱯᱞᱟ ᱫᱚᱥᱟ᱾ᱵᱟᱯᱞᱟ ᱫᱚᱥᱟ᱾</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱵᱟᱯᱞᱟ ᱫᱚᱥᱟ  ᱾ᱵᱟᱯᱞᱟ ᱫᱚᱥᱟ ᱾</value></prop></node><node oor:name="spousename"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱡᱟᱣᱟᱸᱭ ᱧᱩᱛᱩᱢ ᱾ᱡᱟᱣᱟᱸᱭ ᱧᱩᱛᱩᱢ᱾</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱡᱟᱣᱟᱸᱭ ᱧᱩᱛᱩᱢ ᱾ᱡᱟᱣᱟᱸᱭ ᱧᱩᱛᱩᱢ᱾</value></prop></node><node oor:name="nickname"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱵᱟᱦᱨᱮ ᱧᱩᱛᱩᱢ ᱾ (~x)</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱵᱟᱦᱨᱮ ᱧᱩᱛᱩᱢ ᱾ (~x)</value></prop></node><node oor:name="hobbies"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱥᱟᱱᱟ, ᱠᱩᱥᱤ ᱠᱚ ᱾ᱥᱟᱱᱟ, ᱠᱩᱥᱤ ᱠᱚ  ᱾</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱥᱟᱱᱟ, ᱠᱩᱥᱤ ᱠᱚ ᱾ᱥᱟᱱᱟ, ᱠᱩᱥᱤ ᱠᱚ  ᱾</value></prop></node><node oor:name="childrennames"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱜᱤᱫᱨᱟᱹ ᱠᱚᱣᱟᱜ ᱧᱩᱛᱩᱢ᱾ᱜᱤᱫᱨᱟᱹ ᱠᱚᱣᱟᱜ ᱧᱩᱛᱩᱢ᱾</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱜᱤᱫᱨᱟᱹ ᱠᱚᱣᱟᱜ ᱧᱩᱛᱩᱢ᱾ᱜᱤᱫᱨᱟᱹ ᱠᱚᱣᱟᱜ ᱧᱩᱛᱩᱢ᱾</value></prop></node><node oor:name="photo"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱢᱚᱦᱚᱨ ᱪᱤᱛᱟᱹᱨ᱾ᱢᱚᱦᱚᱨ ᱪᱤᱛᱟᱹᱨ᱾</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱢᱚᱦᱚᱨ ᱪᱤᱛᱟᱹᱨ᱾ᱢᱚᱦᱚᱨ ᱪᱤᱛᱟᱹᱨ᱾</value></prop></node><node oor:name="notes"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱱᱚᱴᱥ</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱱᱚᱴᱥ</value></prop></node><node oor:name="dateupdated"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱢᱟᱹᱦᱤᱫ ᱦᱟᱹᱞᱤᱭᱟᱜ ᱾ᱠᱷᱟᱴᱚ ᱚᱞ ᱠᱚ ᱾</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱟᱨᱡᱟᱣ ᱳᱰᱚᱠᱟᱨᱡᱟᱣ ᱳᱰᱚᱠ</value></prop></node></node></node><node oor:name="householdinventory"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱳᱲᱟᱜ ᱨᱮᱭᱟᱜ ᱟᱨᱡᱟᱣᱳᱲᱟᱜ ᱨᱮᱭᱟᱜ ᱟᱨᱡᱟᱣ</value></prop><node oor:name="Fields"><node oor:name="inventoryID"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱟᱨᱡᱟᱣ ᱳᱰᱚᱠ ID</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱟᱨᱡᱟᱣ ᱳᱰᱚᱠ ID</value></prop></node><node oor:name="categoryID"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱦᱟᱹᱴᱤᱧ ID᱾ᱦᱟᱹᱴᱤᱧ ID ᱾</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱦᱟᱹᱴᱤᱧ ID᱾ᱦᱟᱹᱴᱤᱧ ID ᱾</value></prop></node><node oor:name="roomID"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱠᱚᱴᱨᱤ ID᱾ᱠᱚᱴᱨᱤID᱾</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱠᱚᱴᱨᱤ ID᱾ᱠᱚᱴᱨᱤID᱾</value></prop></node><node oor:name="item"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱡᱤᱱᱤᱥ</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱡᱤᱱᱤᱥ</value></prop></node><node oor:name="itemtype"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱡᱤᱱᱤᱥ ᱞᱮᱠᱟᱱ ᱾ᱡᱤᱱᱤᱥ ᱞᱮᱠᱟᱱ ᱾</value></prop><prop oor:n