xml:lang="sat-Olck">ᱠᱤᱨᱤᱧ ᱢᱟᱹᱦᱤᱫᱠᱤᱨᱤᱧ ᱢᱟᱹᱦᱤᱫ</value></prop></node><node oor:name="datesubmitted"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱡᱚᱢᱟ  ᱢᱟᱹᱦᱤᱫᱡᱚᱢᱟ  ᱢᱟᱹᱦᱤᱫ</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱡᱚᱢᱟ ᱢᱟᱹᱦᱤᱫᱡᱚᱢᱟ ᱢᱟᱹᱦᱤᱫ</value></prop></node><node oor:name="amountspent"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱠᱟᱹᱣᱲᱤ ᱠᱷᱚᱨᱚᱪᱠᱟᱹᱣᱲᱤ ᱠᱷᱚᱨᱚᱪ</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱠᱟᱹᱣᱲᱤ ᱠᱷᱚᱨᱚᱪᱠᱟᱹᱣᱲᱤ ᱠᱷᱚᱨᱚᱪ</value></prop></node><node oor:name="advanceamount"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱢᱟᱲᱟᱝ ᱛᱮᱭᱟᱜ ᱠᱟᱣᱲᱤᱢᱟᱲᱟᱝ ᱛᱮᱭᱟᱜ ᱠᱟᱣᱲᱤ</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱢᱟᱲᱟᱝ ᱛᱮᱭᱟᱜ ᱠᱟᱣᱲᱤᱢᱟᱲᱟᱝ ᱛᱮᱭᱟᱜ ᱠᱟᱣᱲᱤ</value></prop></node><node oor:name="paymentmethod"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱫᱚᱨᱢᱟ ᱣᱤᱫᱷᱟᱹᱱ᱾ᱫᱚᱨᱢᱟ ᱣᱤᱫᱷᱟᱱ ᱾</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱫᱚᱨᱢᱟ ᱣᱤᱫᱷᱟᱹᱱ᱾ᱫᱚᱨᱢᱟ  ᱣᱤᱫᱷᱟᱱ᱾</value></prop></node><node oor:name="notes"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱱᱚᱴᱥ</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱱᱚᱴᱥ</value></prop></node></node></node><node oor:name="deliveries"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱮᱢ ᱟᱞᱟᱭ ᱠᱚ (~t)</value></prop><node oor:name="Fields"><node oor:name="deliveryID"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱪᱷᱟᱰᱟᱣ ID᱾ᱮᱢ ᱟᱞᱟᱭ ID᱾</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱪᱷᱟᱰᱟᱣ ID᱾ᱮᱢ ᱟᱞᱟᱭ ID᱾</value></prop></node><node oor:name="customerID"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱜᱚᱦᱨᱟᱜ ᱠᱚ ID᱾ᱜᱚᱦᱨᱟᱜ ᱠᱚᱣᱟᱜ ID᱾</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱜᱚᱦᱨᱟᱜ ᱠᱚ ID᱾ᱜᱚᱦᱨᱟᱜ ᱠᱚᱣᱟᱜ ID᱾</value></prop></node><node oor:name="orderID"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱛᱷᱟᱨ ᱠᱚ ID᱾ᱯᱚᱨᱢᱟᱥ ID᱾</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱛᱷᱟᱨ ᱠᱚ ID᱾ᱯᱚᱨᱢᱟᱥ ID᱾</value></prop></node><node oor:name="employeeID"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱠᱟᱹᱢᱤᱭᱟ ᱠᱚ ID᱾ᱠᱟᱹᱢᱤᱭᱟᱹ ID᱾</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱠᱟᱹᱢᱤᱭᱟ ᱠᱚ ID᱾ᱠᱟᱹᱢᱤᱭᱟᱹ ID᱾</value></prop></node><node oor:name="shippedfrom"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱠᱷᱚᱱ ᱠᱩᱞᱠᱷᱚᱱ ᱠᱩᱞ</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱠᱷᱚᱱ ᱠᱩᱞᱠᱷᱚᱱ ᱠᱩᱞ</value></prop></node><node oor:name="shippedvia"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱠᱷᱚᱱ ᱛᱮ ᱠᱩᱞ ᱾ᱡᱟᱦᱟᱡ  ᱥᱮᱫ ᱛᱮ ᱾</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱠᱷᱚᱱ ᱛᱮ ᱠᱩᱞ ᱾ᱡᱟᱦᱟᱡ  ᱥᱮᱫ ᱛᱮ ᱾</value></prop></node><node oor:name="trackingcode"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱯᱟᱸᱡᱟ ᱫᱟᱱᱟᱝ ᱪᱤᱱᱦᱟᱹᱯᱟᱸᱡᱟ ᱫᱟᱱᱟᱝ ᱪᱤᱱᱦᱟᱹ</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱯᱟᱸᱡᱟ ᱫᱟᱱᱟᱝ ᱪᱤᱱᱦᱟᱹᱯᱟᱸᱡᱟ ᱫᱟᱱᱟᱝ ᱪᱤᱱᱦᱟᱹ</value></prop></node><node oor:name="shipdate"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱡᱟᱦᱟᱡ ᱢᱟᱹᱦᱤᱫ᱾ᱡᱟᱦᱟᱡ ᱢᱟᱹᱦᱤᱫ ᱾</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱡᱟᱦᱟᱡ ᱢᱟᱹᱦᱤᱫ᱾ᱡᱟᱦᱟᱡ ᱢᱟᱹᱦᱤᱫ ᱾</value></prop></node><node oor:name="shipperphonenumber"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱠᱩᱞᱤᱡᱟᱜ ᱥᱟᱸᱜᱤᱧ ᱜᱟᱞ  ᱞᱮᱠᱷᱟᱠᱩᱞᱤᱡᱟᱜ ᱥᱟᱸᱜᱤᱧ ᱜᱟᱞ  ᱞᱮᱠᱷᱟ</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱡᱟᱦᱟᱡ ᱥᱟᱸᱜᱤᱧ ᱜᱟᱞ ᱞᱮᱠᱷᱟ  ᱾ᱠᱩᱞᱤᱡᱟᱜ ᱥᱟᱸᱜᱤᱧ ᱜᱟᱞ  ᱞᱮᱠᱷᱟ  ᱾</value></prop></node><node oor:name="destinationaddress"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱥᱟᱸᱜᱤᱧ  ᱛᱮᱭᱟᱜ ᱴᱷᱤᱠᱟᱹᱱᱟᱥᱟᱸᱜᱤᱧ  ᱛᱮᱭᱟᱜ ᱴᱷᱤᱠᱟᱹᱱᱟ</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱥᱟᱸᱜᱤᱧ   ᱴᱷᱤᱠᱟᱹᱱᱟᱥᱟᱸᱜᱤᱧ   ᱴᱷᱤᱠᱟᱹᱱᱟ</value></prop></node><node oor:name="destinationcity"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱥᱟᱸᱜᱤᱧ  ᱛᱮᱭᱟᱜ ᱥᱮᱸᱰᱟ ᱥᱚᱦᱚᱨᱥᱟᱸᱜᱤᱧ  ᱛᱮᱭᱟᱜ ᱥᱮᱸᱰᱟ ᱥᱚᱦᱚᱨ</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱥᱟᱸᱜᱤᱧ  ᱥᱮᱸᱲᱟ ᱥᱚᱦᱚᱨ</value></prop></node><node oor:name="destinationstateprovince"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱥᱟᱸᱜᱤᱧ ᱯᱚᱱᱚᱛ ᱨᱟᱡᱥᱟᱸᱜᱤᱧ ᱯᱚᱱᱚᱛ ᱨᱟᱡ</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱥᱟᱸᱜᱤᱧ ᱯᱚᱱᱚᱛ ᱨᱟᱡᱥᱟᱸᱜᱤᱧ ᱯᱚᱱᱚᱛ ᱨᱟᱡ</value></prop></node><node oor:name="destinationpostalcode"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱥᱟᱸᱜᱤᱧ ᱰᱟᱠ ᱞᱮᱠᱷᱟ ᱪᱤᱱᱦᱟᱹ</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱥᱟᱸᱜᱤᱧ ᱰᱟᱠ ᱞᱮᱠᱷᱟ ᱪᱤᱱᱦᱟᱹ</value></prop></node><node oor:name="destinationcountryregion"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱥᱟᱸᱜᱤᱧ ᱫᱤᱥᱚᱢ ᱴᱷᱚᱴᱟᱥᱟᱸᱜᱤᱧ ᱫᱤᱥᱚᱢ ᱴᱷᱚᱴᱟ</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱥᱟᱸᱜᱤᱧ ᱫᱤᱥᱚᱢ ᱴᱷᱚᱴᱟᱥᱟᱸᱜᱤᱧ ᱫᱤᱥᱚᱢ ᱴᱷᱚᱴᱟ</value></prop></node><node oor:name="arrivaldate"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱥᱮᱴᱮᱨᱚᱠ ᱢᱟᱹᱦᱤᱫ (~n)</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱥᱟᱸᱜᱤᱧ ᱫᱤᱥᱚᱢ ᱴᱷᱚᱴᱟᱥᱟᱸᱜᱤᱧ ᱫᱤᱥᱚᱢ ᱴᱷᱚᱴᱟ</value></prop></node><node oor:name="arrivaltime"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱥᱮᱴᱚᱨᱚᱠ ᱳᱠᱛᱚᱥᱮᱴᱚᱨᱚᱠ ᱳᱠᱛᱚ</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱥᱮᱴᱚᱨᱚᱠ ᱳᱠᱛᱚᱥᱮᱴᱚᱨᱚᱠ ᱳᱠᱛᱚ</value></prop></node><node oor:name="currentlocation"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱱᱤᱛᱚᱜᱟᱜ ᱡᱟᱭᱜᱟ ᱴᱷᱟᱸᱣ (~v)</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱱᱤᱛᱚᱜᱟᱠ ᱡᱟᱭᱜᱟ ᱴᱷᱟᱸᱣᱱᱤᱛᱚᱜᱟᱠ ᱡᱟᱭᱜᱟ ᱴᱷᱟᱸᱣ</value></prop></node><node oor:name="packagedimensions"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱜᱷᱮᱸᱴ ᱢᱟᱯ ᱠᱚᱜᱷᱮᱸᱴ ᱢᱟᱯ ᱠᱚ</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱜᱷᱮᱸᱴ ᱢᱟᱯ ᱠᱚᱜᱷᱮᱸᱴ ᱢᱟᱯ ᱠᱚ</value></prop></node><node oor:name="packageweight"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱜᱷᱮᱸᱴ ᱦᱟᱢᱟᱞ</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱜᱷᱮᱸᱴ ᱦᱟᱢᱟᱞᱜᱷᱮᱸᱴ ᱦᱟᱢᱟᱞ</value></prop></node><node oor:name="pickuplocation"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱦᱟᱞᱟᱝ ᱡᱟᱭᱜᱟᱦᱟᱞᱟᱝ ᱡᱟᱭᱜᱟ</value></prop><prop oor:name="ShortName"><value xml:lang="sat-Olck">ᱦᱟᱞᱟᱝ ᱡᱟᱭᱜᱟᱦᱟᱞᱟᱝ ᱡᱟᱭᱜᱟ</value></prop></node><node oor:name="pickupdate"><prop oor:name="Name"><value xml:lang="sat-Olck">ᱦᱟᱞᱟᱝ ᱢᱟᱹᱦᱤᱫ᱾ᱦᱟᱞᱟᱝ ᱢᱟᱹᱦᱤᱫ ᱾</value></prop><prop oor:name="ShortName"